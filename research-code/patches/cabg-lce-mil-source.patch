+            if step==24:phenotypes[f'R{i}']=phenotype(mm,late[i])
+        comparable=lambda rows:[{k:v for k,v in r.items() if k!='raw'} for r in rows]
+        eval_exact[str(step)]=comparable(rows[0])==comparable(rows[1]);exact &= eval_exact[str(step)]
