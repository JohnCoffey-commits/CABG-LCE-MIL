+
+def verify_eval(root,run,step,manifest):
+    path=root/f'eval-R{run}-b{step}';rows=read_json(path/'predictions.json')
+    assert len(rows)==32
+    for i,(row,expected) in enumerate(zip(rows,manifest)):
