+        _exclusive_json(args.rng_audit_output, rng_result)
+        phases.mark("diagnostic_completed")
+        del model, wrapper, dataset, collator, parameters, trainable_parameters
+        wrapper = None
+        gc.collect()
+        torch.cuda.empty_cache()
+        torch.cuda.synchronize()
