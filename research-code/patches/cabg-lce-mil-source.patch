+  local rc=$?
+  if (( rc != 0 )); then
+    printf 'FAILED:%s:%s\n' "$rc" "$current_run" > "$LOG_ROOT/stage2g.status"
+    if [[ -n "$current_run" && -d "$RUNS_ROOT/$current_run" ]]; then
+      printf 'FAILED:%s\n' "$rc" > "$RUNS_ROOT/$current_run/run.status"
