+        --output "$run_root/result.json" \
+        --run-id "$run_id" \
+        --expected-source-commit ad62e7c910f4febad7b07030bd1c11796ae064e7 \
+        --expected-model-revision 9374b660aade05e190471c5501fefac548982169
