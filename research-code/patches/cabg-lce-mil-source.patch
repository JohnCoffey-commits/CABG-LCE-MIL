+def exact_ranking(rows):
+    from fractions import Fraction
+    positives=sum(r['label']=='abnormal' for r in rows);negatives=len(rows)-positives
+    assert positives>0 and negatives>0 and all(r['label'] in ('normal','abnormal') and math.isfinite(r['score']) for r in rows)
+    twice_wins=0
+    for r in rows:
+        if r['label']!='abnormal':continue
+        for n in rows:
+            if n['label']=='normal':twice_wins+=2*int(r['score']>n['score'])+int(r['score']==n['score'])
+    bins={score:[sum(r['score']==score and r['label']=='abnormal' for r in rows),sum(r['score']==score for r in rows)] for score in {r['score'] for r in rows}}
+    tp=seen=0;ap=Fraction(0)
+    for score in sorted(bins,reverse=True):
+        new,count=bins[score];tp+=new;seen+=count;ap+=Fraction(new*tp,positives*seen)
+    return dict(auroc=Fraction(twice_wins,2*positives*negatives),average_precision=ap)
+
+def verdict(ranks):
+    assert set(ranks)=={'43','44'} and all(set(r)=={'none','early','late','full'} for r in ranks.values())
+    comparisons={};gains=[];orders=[]
+    for seed in ('43','44'):
+        r=ranks[seed];g=[r['late'][k]-r['none'][k] for k in ('auroc','average_precision')];t=[r['late'][k]-r['early'][k] for k in ('auroc','average_precision')]
+        gp='GAIN_BOTH' if g[0]>0 and g[1]>0 else 'NO_GAIN_BOTH' if g[0]<=0 and g[1]<=0 else 'MIXED_METRICS_OR_TIE'
+        tp='LATE_MATCHES_OR_EXCEEDS_BOTH' if t[0]>=0 and t[1]>=0 else 'EARLY_HIGHER_BOTH' if t[0]<0 and t[1]<0 else 'MIXED_METRICS_OR_TIE'
+        comparisons[seed]=dict(late_vs_none=dict(exact=dict(zip(('auroc','average_precision'),map(str,g))),pattern=gp),
+            late_vs_early=dict(exact=dict(zip(('auroc','average_precision'),map(str,t))),pattern=tp))
+        gains.append(gp);orders.append(tp)
+    gain='DESCRIPTIVE_LATE_ONLY_GAIN_2_OF_2' if gains==['GAIN_BOTH']*2 else 'NO_LATE_ONLY_GAIN_2_OF_2' if gains==['NO_GAIN_BOTH']*2 else 'MIXED_OR_METRIC_DEPENDENT_LATE_GAIN'
+    order='LATE_MATCHES_OR_EXCEEDS_EARLY_2_OF_2' if orders==['LATE_MATCHES_OR_EXCEEDS_BOTH']*2 else 'EARLY_HIGHER_BOTH_2_OF_2' if orders==['EARLY_HIGHER_BOTH']*2 else 'MIXED_EARLY_LATE_ORDERING'
+    return dict(late_gain=gain,early_late_order=order),comparisons
