+  printf 'TERMINAL_BLOCKER:post_wrapper_inventory:%s\n' "$post_wrapper_inventory_status" > "$run_status"
+  exit "$post_wrapper_inventory_status"
+fi
+printf '%s\n' 'SUCCESS' > "$run_status"
