+  > >(tee -a "$AGGREGATE_ROOT/aggregate.log") 2>&1
+
+PYTHONPATH="$REPO:$REPO/qwen-vl-finetune" "$ADAPTER_PYTHON" \
+  "$REPO/reproduction/stage2g/verify_aggregate.py" \
+  --registry "$REGISTRY" \
+  --runs-root "$RUNS_ROOT" \
+  --aggregate "$AGGREGATE_ROOT/aggregate.json" \
