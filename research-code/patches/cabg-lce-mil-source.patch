+        balanced = {}
+        for objective in ("lm", "lce"):
+            class_rms = {label: math.sqrt(sum(r[objective + "_s9_norm"] ** 2 for r in images if r["label"] == label) / sum(r["label"] == label for r in images)) for label in ("normal", "abnormal")}
