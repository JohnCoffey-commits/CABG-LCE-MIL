+#!/usr/bin/env bash
+
+set -euo pipefail
+
+MEDIC_AD_SEED=${MEDIC_AD_SEED:?Set MEDIC_AD_SEED to 42, 123, or 2026}
+case "${MEDIC_AD_SEED}" in
+    42|123|2026) ;;
+    *) echo "Unsupported MEDIC_AD_SEED: ${MEDIC_AD_SEED}" >&2; exit 2 ;;
+esac
