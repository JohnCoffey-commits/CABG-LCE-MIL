+mkdir "$root"
+for arm in dynamic frozen_ratio lce_off; do
+  "$python" -m reproduction.stage2u.train --execute --code-commit "$commit" --plan "$plan" --campaign "$root" --arm "$arm" > "$root/$arm.log" 2>&1
