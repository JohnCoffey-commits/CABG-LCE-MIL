+        value=float((t['logsumexp'].double()-t['target_logit'].double()).mean())
+        close(value,row['lm_loss'],'teacher-forced shifted LM loss',atol=2e-6,rtol=2e-6)
+    summary=metrics(rows);producer=read_json(path/'metrics.json')
