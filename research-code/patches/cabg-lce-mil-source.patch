+                observed["abnormal_raw"], observed["normal_raw"], [label]
+            )
+            lm_gradients = torch.autograd.grad(result.loss, trainable_parameters, retain_graph=True, allow_unused=True)
+            lm_rows = gradient_rows(trainable_names, lm_gradients)
+            mechanism_records = {}
