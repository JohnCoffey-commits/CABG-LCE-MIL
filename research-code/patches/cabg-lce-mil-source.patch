+STATUS_FILE=${LOG_DIR}/multiseed-aggregate.status
+
+for seed in 42 123 2026; do
+    if [[ ! -e "${LOG_DIR}/seed-${seed}-generation.json" ]]; then
+        echo "Missing generation result for seed ${seed}" >&2
