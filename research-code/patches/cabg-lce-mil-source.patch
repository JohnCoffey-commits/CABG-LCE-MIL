+def close(a, b, context):
+    require(math.isfinite(float(a)) and math.isfinite(float(b)) and math.isclose(float(a), float(b), rel_tol=2e-6, abs_tol=1e-10), f"Scalar mismatch: {context}: {a} vs {b}")
