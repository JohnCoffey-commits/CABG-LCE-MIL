+        training_verification_sha256=sha256_file(root/'training-verification.json'),reference_verification_sha256=sha256_file(root/'reference-verification.json'),producer_sha256=sha256_file(root/'timing-result.json'),
+        new_evaluations=evaluations,historical_inputs_checked=dict(stage2v=ins.checked,stage2z=ins.zchecked),raw_files=raw_files,budget=budget['counts'],
